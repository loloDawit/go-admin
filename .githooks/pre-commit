#!/bin/sh
# Keeps internal working files out of this public repository.
#
# .gitignore does not stop `git add -f`, which is how five internal task
# reports became tracked once already. This checks the staged set, so a
# force-add still gets caught.
#
# Install: make hooks
# Bypass:  git commit --no-verify

set -eu

leaked=$(git diff --cached --name-only --diff-filter=ACMR \
	| grep -E '^(\.superpowers/|\.claude/|docs/|CLAUDE\.md$)' || true)

[ -z "$leaked" ] && exit 0

printf '\033[31m%s\033[0m\n' "Internal working files are staged:" >&2
printf '  %s\n' $leaked >&2
printf '\033[31m%s\033[0m\n' \
	"These are deliberately untracked. Unstage them, or --no-verify if deliberate." >&2
exit 1
